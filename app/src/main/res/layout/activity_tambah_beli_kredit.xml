<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".TambahKreditActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tambah Pembelian Kredit"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/edit_kode_kredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kode Kredit"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Pembeli"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_pembeli"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Mobil"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_mobil"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Paket Kredit"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_paket"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edit_tanggal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tanggal Kredit"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edit_cicilan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cicilan per Bulan"
            android:inputType="numberDecimal"
            android:focusable="false"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/tombol_simpan_kredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Kredit" />

    </LinearLayout>

</ScrollView>
