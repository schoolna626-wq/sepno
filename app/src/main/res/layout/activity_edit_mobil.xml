<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Data Mobil"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/editkode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Kode Mobil"
        android:inputType="text"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/editmerk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Merk Mobil"
        android:inputType="text"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/edittype"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Type Mobil"
        android:inputType="text"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/editwarna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Warna Mobil"
        android:inputType="text"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/editharga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Harga Mobil"
        android:inputType="number"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/tombolupdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UPDATE DATA" />

</LinearLayout>