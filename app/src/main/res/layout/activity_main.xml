<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="#FBF8FF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selamat Datang di Showroom Ajix"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_data_mobil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Data Mobil"
        android:backgroundTint="#65558F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_data_pembeli"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Data Pembeli"
        android:backgroundTint="#65558F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_data_paket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Data Paket"
        android:backgroundTint="#65558F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_data_cash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Data Beli Cash"
        android:backgroundTint="#65558F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_data_kredit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Data Beli Kredit"
        android:backgroundTint="#65558F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_data_cicilan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Data Bayar Cicilan"
        android:backgroundTint="#65558F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

</LinearLayout>